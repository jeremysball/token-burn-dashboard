#!/bin/sh
# Fast local quality gate: lint (staged files only) + typecheck (whole project).
# Errors block the commit; lint warnings do not. Full tests run in CI, not here.
# Bypass with: git commit --no-verify

staged_js=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js')

if [ -n "$staged_js" ]; then
    echo "Running eslint on staged files..."
    bunx eslint $staged_js || {
        echo "eslint found blocking errors."
        exit 1
    }

    echo "Running lint baseline..."
    bun run lint:baseline || exit 1
fi

echo "Running typecheck..."
bunx tsc --noEmit || exit 1

exit 0

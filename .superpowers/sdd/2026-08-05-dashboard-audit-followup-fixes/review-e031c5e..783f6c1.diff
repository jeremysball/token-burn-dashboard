++const readyFile = process.env.ROGUE_GRANDCHILD_READY_FILE || '';
++const exitFile = process.env.ROGUE_GRANDCHILD_EXIT_FILE || '';
++const lifetime = Number(process.env.ROGUE_GRANDCHILD_LIFETIME_MS || 5000);

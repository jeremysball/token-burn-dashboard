++  // stay linear.
++  const errors = [];
++  const parentPid = readPidIfExists(files.parent, errors);
++  const grandchildPid = readPidIfExists(files.grandchild, errors);
++  if (errors.length > 0) throw new Error(errors.join('; '));
++  return { parentPid, grandchildPid };
